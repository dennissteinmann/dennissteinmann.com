---
import '@fontsource-variable/eb-garamond';
import '@fontsource-variable/eb-garamond/wght-italic.css';
import '@fontsource-variable/archivo';
import '@/styles/global.css';

import SEO, { type Props as SEOProps } from '@/components/SEO.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

export type Props = SEOProps;
const seo = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <SEO {...seo} />
  </head>
  <body>
    <a class="skip-link" href="#main">Zum Inhalt springen</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Scroll-Einblendung: Elemente mit [data-reveal] steigen ruhig auf.
      // Respektiert prefers-reduced-motion und funktioniert ohne JS (sichtbar).
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (items.length && !reduce && 'IntersectionObserver' in window) {
        for (const el of items) el.classList.add('is-hidden');
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              const el = e.target as HTMLElement;
              const d = el.dataset.reveal;
              if (d) el.style.transitionDelay = `${d}ms`;
              el.classList.add('is-in');
              el.classList.remove('is-hidden');
              io.unobserve(el);
            }
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.1 },
        );
        for (const el of items) io.observe(el);
      }
    </script>
  </body>
</html>
