---
/** Über = Entitäts-Hub der Person (ProfilePage). Text: src/content/pages/ueber.mdx */
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { mdxComponents } from '@/components/mdx';
import portrait from '@/assets/brand/portrait.jpg';
import signature from '@/assets/brand/signature.png';
import { PERSON } from '@/site.config';
import { getTopics } from '@/lib/content';
import { abs, breadcrumbSchema, graph, ID, personSchema, websiteSchema } from '@/lib/seo';

const page = await getEntry('pages', 'ueber');
if (!page) throw new Error('src/content/pages/ueber.mdx fehlt');
const { Content } = await render(page);
const topics = await getTopics();
const crumbs = [{ name: 'Start', path: '/' }, { name: page.data.title, path: '/ueber/' }];
const jsonLd = graph(websiteSchema(), await personSchema(), breadcrumbSchema(crumbs), {
  '@type': 'ProfilePage', '@id': `${abs('/ueber/')}#page`, url: abs('/ueber/'), name: page.data.title, mainEntity: { '@id': ID.person },
  ...(page.data.updated ? { dateModified: page.data.updated.toISOString() } : {}),
});
---

<BaseLayout title={page.data.seoTitle ?? page.data.title} description={page.data.description} type="profile" jsonLd={jsonLd}>
  <section class="wrap about">
    <figure class="about__img"><Image src={portrait} alt={`Porträt von ${PERSON.name}`} widths={[360, 600, 900]} sizes="(min-width: 900px) 33vw, 90vw" loading="eager" /></figure>
    <div class="about__text">
      <h1 class="display t-xl">{PERSON.name}</h1>
      <p class="lead">{PERSON.jobTitle}</p>
      <div class="prose"><Content components={mdxComponents} /></div>
      <p class="meta topics">Themen: {topics.map((t, i) => <>{i > 0 && ', '}<a href={`/themen/${t.id}/`}>{t.data.title}</a></>)}</p>
      <Image src={signature} alt="" width={240} class="sign" />
    </div>
  </section>
  <div class="wrap"><Breadcrumbs crumbs={crumbs} /></div>
</BaseLayout>

<style>
  .about { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); padding-top: var(--s-7); align-items: start; }
  .about__img { grid-column: 1 / span 4; position: sticky; top: var(--s-5); }
  .about__img :global(img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }
  .about__text { grid-column: 6 / span 7; }
  .about__text .lead { margin-top: var(--s-2); color: var(--grey); }
  .about__text .prose { margin-top: var(--s-6); }
  .topics { margin-top: var(--s-6); }
  .topics a { color: inherit; }
  .about :global(.sign) { margin-top: var(--s-6); width: 200px; filter: invert(1); opacity: 0.85; }
  @media (max-width: 900px) { .about { grid-template-columns: 1fr; } .about__img, .about__text { grid-column: 1; position: static; } .about__img { max-width: 70%; margin-bottom: var(--s-5); } }
</style>
