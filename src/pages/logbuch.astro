---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import LogList from '@/components/LogList.astro';
import { getLog, getProjects } from '@/lib/content';
import { breadcrumbSchema, graph, websiteSchema } from '@/lib/seo';

const entries = await getLog();
const projectNames = new Map((await getProjects()).map((p) => [p.id, p.data.title]));
const title = 'Logbuch';
const description = 'Das Logbuch von Dennis Steinmann: kurze, datierte Notizen über Fortschritte, Releases und Erkenntnisse aus allen laufenden Projekten.';
const crumbs = [{ name: 'Start', path: '/' }, { name: title, path: '/logbuch/' }];
---

<BaseLayout title={title} description={description} jsonLd={graph(websiteSchema(), breadcrumbSchema(crumbs))}>
  <PageHeader title="Logbuch" lead="Kurze Notizen, wenn etwas passiert. Schritt für Schritt." crumbs={crumbs} />
  <section class="wrap space"><LogList entries={entries} projectNames={projectNames} /></section>
</BaseLayout>
