---
/**
 * Startseite = die ganze Website: Briefkopf und alle Abschnitte (Unternehmen,
 * Projekte, Werdegang …) – vollständig aus INHALT.md. Jeder Abschnitt ist ein
 * Register aus Einträgen; leere Abschnitte erscheinen nicht.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Crest from '@/components/Crest.astro';
import RichText from '@/components/RichText.astro';
import { SITE, activeChannels } from '@/site.config';
import { getInhalt } from '@/lib/inhalt';
import { graph, personSchema, registerSchemas, websiteSchema } from '@/lib/seo';

const inhalt = getInhalt();
const channels = activeChannels();
---

<BaseLayout title={SITE.name} description={SITE.description} type="profile" jsonLd={graph(websiteSchema(), personSchema(), ...registerSchemas())}>
  {/* Briefkopf: Wappen, Wortmarke, faktische Zeile, Profile, Zierlinie. */}
  <section class="wrap masthead">
    <Crest size="clamp(4.5rem, 3.5rem + 4vw, 7.5rem)" class="masthead__crest" />
    <h1 class="mark masthead__name">{inhalt.name}</h1>
    <hr class="rule rule--brass masthead__rule" />
    <p class="label masthead__role">
      <span>{inhalt.titel}</span>
      {inhalt.ort && <><span class="masthead__sep" aria-hidden="true"> · </span><span>{inhalt.ort}</span></>}
    </p>
    {inhalt.intro && <p class="masthead__lead">{inhalt.intro}</p>}
    <p class="masthead__contact">
      <a class="link" href="/kontakt/">Kontakt</a>
      {channels.map((c) => <a class="link" href={c.url} rel="me noopener">{c.name}</a>)}
    </p>
    <hr class="rule rule--double masthead__close" />
  </section>

  {inhalt.abschnitte.map((a) => (
    <section class="wrap abschnitt" id={a.id} aria-labelledby={`${a.id}-h`}>
      <div class="sec">
        <h2 id={`${a.id}-h`} class="khead">{a.titel}</h2>
        <div>
          {a.intro.length > 0 && <div class="prose abschnitt__intro"><RichText blocks={a.intro} /></div>}
          {a.eintraege.length > 0 && (
            <ol role="list" class="register">
              {a.eintraege.map((e) => (
                <li class="eintrag" id={e.id}>
                  <div>
                    <h3 class="eintrag__titel">{e.titel}</h3>
                    {e.rolle && <p class="meta eintrag__rolle">{e.rolle}</p>}
                  </div>
                  <div class="eintrag__text"><RichText blocks={e.text} /></div>
                  <div class="eintrag__meta">
                    {e.zeit && <p class="meta eintrag__zeit">{e.zeit}</p>}
                    {e.ort && <p class="meta">{e.ort}</p>}
                    {e.status && <p class="label eintrag__status">{e.status}</p>}
                    {e.link && <a class="link" href={e.link} rel="noopener">{e.linkText}</a>}
                  </div>
                </li>
              ))}
            </ol>
          )}
        </div>
      </div>
    </section>
  ))}
</BaseLayout>

<style>
  /* Briefkopf: zentriert, symmetrisch, ruhig. */
  .masthead { display: flex; flex-direction: column; align-items: center; text-align: center; padding-top: clamp(3.5rem, 10vh, 7.5rem); padding-bottom: var(--s-6); }
  .masthead :global(.masthead__crest) { color: var(--navy); }
  .masthead__name {
    margin-top: var(--s-5); font-size: clamp(2rem, 0.8rem + 5.2vw, 5.4rem); font-weight: var(--w-regular);
    letter-spacing: var(--track-mark); padding-left: var(--track-mark); /* gleicht die Sperrung des letzten Buchstabens aus */
    color: var(--ink); line-height: 1.1;
  }
  .masthead__rule { margin-top: var(--s-5); }
  .masthead__role { margin-top: var(--s-4); color: var(--ink-soft); }
  .masthead__lead { margin-top: var(--s-3); font-size: var(--t-m); font-weight: var(--w-light); color: var(--ink-soft); max-width: 32em; }
  .masthead__contact { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--s-2) var(--s-5); margin-top: var(--s-5); }
  .masthead__close { width: 100%; margin-top: var(--s-6); }

  /* Abschnitte: Titel links, Inhalt rechts; ab dem zweiten mit feiner Linie. */
  .abschnitt { padding-bottom: var(--s-6); }
  .abschnitt + .abschnitt .sec { border-top: 1px solid var(--fg); padding-top: var(--s-4); }

  .abschnitt__intro { margin-bottom: var(--s-5); }

  /* Register (Unternehmen, Projekte, Werdegang …): Titel & Rolle · Beschreibung · Zeit, Ort, Status, Link. */
  .eintrag {
    display: grid; grid-template-columns: 4fr 6fr 2fr; gap: var(--s-2) var(--gutter); align-items: baseline;
    padding-block: var(--s-4); border-bottom: 1px solid var(--line); scroll-margin-top: 5rem;
  }
  .eintrag:first-child { padding-top: 0; }
  .abschnitt__intro + .register .eintrag:first-child { padding-top: var(--s-4); border-top: 1px solid var(--line); }
  .eintrag__titel { font-size: var(--t-m); line-height: 1.2; }
  .eintrag__rolle { margin-top: var(--s-1); }
  .eintrag__text { color: var(--ink-soft); }
  .eintrag__text :global(p + p), .eintrag__text :global(ul) { margin-top: var(--s-2); }
  .eintrag__text :global(ul) { padding-left: 1.1em; }
  .eintrag__text :global(ul > li::marker) { content: '–  '; color: var(--grey); }
  .eintrag__meta { display: grid; gap: var(--s-1); justify-items: end; text-align: right; }
  .eintrag__zeit { font-variant-numeric: tabular-nums; }
  .eintrag__status { color: var(--accent); }

  @media (max-width: 600px) {
    .masthead__role span { display: block; }
    .masthead__role .masthead__sep { display: none; }
  }
  @media (max-width: 760px) {
    .eintrag { grid-template-columns: 1fr; }
    .eintrag__meta { justify-items: start; text-align: left; }
  }
</style>
