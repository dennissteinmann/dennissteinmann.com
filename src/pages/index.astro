---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ExplorationList from '@/components/ExplorationList.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import portrait from '@/assets/brand/portrait.jpg';
import { SITE, PERSON } from '@/site.config';
import { getExplorations, getProjects, getTopics, getPress } from '@/lib/content';
import { graph, personSchema, websiteSchema } from '@/lib/seo';

const explorations = (await getExplorations()).slice(0, 5);
const projects = await getProjects();
// Galerie: zuerst große & aktive Projekte mit Bild
const strip = projects
  .filter((p) => p.data.icon || p.data.cover)
  .sort((a, b) => ({ l: 0, m: 1, s: 2 })[a.data.size] - ({ l: 0, m: 1, s: 2 })[b.data.size] || a.data.order - b.data.order)
  .slice(0, 12);
const topics = await getTopics();
const press = await getPress();
---

<BaseLayout title={SITE.name} description={SITE.description} type="profile" jsonLd={graph(websiteSchema(), await personSchema())}>
  <section class="hero wrap">
    <h1 class="display t-xxl hero__statement">
      <span class="sr-only">{SITE.name}: </span>Ich denke öffentlich nach&nbsp;– und baue, was dabei <em>entsteht.</em>
    </h1>
    <div class="hero__aside sans">
      <p>{PERSON.name}<br /><span class="muted">{PERSON.jobTitle}</span></p>
      <p class="muted">{explorations.length > 0 && <>Explorationen über </>}{topics.slice(0, 4).map((t, i) => <>{i > 0 && ', '}<a href={`/themen/${t.id}/`}>{t.data.title}</a></>)}.</p>
    </div>
  </section>

  {explorations.length > 0 && (
    <section class="wrap space">
      <div class="sec">
        <h2 class="display t-m sec__head">Explorationen</h2>
        <div class="sec__body">
          <ExplorationList items={explorations} />
          <p class="sec__more"><a class="link" href="/explorationen/">Alle Explorationen</a></p>
        </div>
      </div>
    </section>
  )}

  <section class="space strip-wrap" aria-labelledby="projects-h">
    <div class="wrap sec">
      <h2 id="projects-h" class="display t-m sec__head">Projekte</h2>
      <p class="sec__body muted sans">{projects.length} Apps, Websites, Plattformen und Unternehmen. <a href="/projekte/">Alle ansehen</a></p>
    </div>
    <div class="strip" tabindex="0" aria-label="Projektgalerie, horizontal scrollbar">
      {strip.map((p) => <div class="strip__item"><ProjectCard project={p} sizes="(min-width: 900px) 26vw, 70vw" /></div>)}
    </div>
  </section>

  <section class="wrap space">
    <div class="sec">
      <h2 class="display t-m sec__head">Themen</h2>
      <ul role="list" class="sec__body topics">
        {topics.map((t) => <li><a class="display plain" href={`/themen/${t.id}/`}>{t.data.title}</a></li>)}
      </ul>
    </div>
  </section>

  <section class="wrap space-l about">
    <figure class="about__img">
      <Image src={portrait} alt={`Porträt von ${PERSON.name}`} widths={[360, 560, 800]} sizes="(min-width: 900px) 28vw, 80vw" class="fade" />
    </figure>
    <div class="about__text">
      <p class="display t-l">{PERSON.description}</p>
      <p class="sans about__links">
        <a href="/ueber/">Über mich</a>
        <a href="/presse/">Presse{press.length > 0 && ` (${press.length})`}</a>
        <a href="/kontakt/">Kontakt</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); padding-top: clamp(6rem, 18vh, 14rem); padding-bottom: var(--s-7); align-items: end; }
  .hero__statement { grid-column: 1 / span 10; max-width: 11.5em; }
  .hero__aside { grid-column: 10 / span 3; margin-top: var(--s-6); display: grid; gap: var(--s-3); }
  .hero__aside a { color: inherit; }

  .sec { display: grid; grid-template-columns: 3fr 9fr; gap: var(--gutter); }
  .sec__head { padding-top: var(--s-5); }
  .sec__more { margin-top: var(--s-4); }

  .strip-wrap .sec { margin-bottom: var(--s-5); align-items: baseline; }
  .strip-wrap .sec__head { padding-top: 0; }
  .strip { display: flex; gap: var(--s-3); overflow-x: auto; padding-inline: var(--gutter); scroll-snap-type: x mandatory; scrollbar-width: none; scroll-padding-inline: var(--gutter); }
  .strip::-webkit-scrollbar { display: none; }
  .strip__item { flex: 0 0 clamp(15rem, 26vw, 26rem); scroll-snap-align: start; }
  .strip__item :global(.pc__stage) { aspect-ratio: 4 / 5 !important; }

  .topics { display: flex; flex-wrap: wrap; gap: 0 0.5em; font-size: var(--t-l); line-height: 1.25; }
  .topics li:not(:last-child)::after { content: ','; color: var(--grey-light); }
  .topics a { transition: opacity var(--fast); }
  .topics a:hover { opacity: 0.5; }

  .about { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); align-items: end; }
  .about__img { grid-column: 2 / span 4; }
  .about__img :global(img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; }
  .about__text { grid-column: 7 / span 5; }
  .about__text .display { line-height: 1.15; }
  .about__links { display: flex; gap: var(--s-4); margin-top: var(--s-5); }

  @media (max-width: 900px) {
    .hero, .about, .sec { grid-template-columns: 1fr; }
    .hero__statement, .hero__aside, .about__img, .about__text { grid-column: 1; }
    .about__img { max-width: 70%; margin-bottom: var(--s-5); }
    .sec__head { padding-top: 0; margin-bottom: var(--s-3); }
  }
</style>
