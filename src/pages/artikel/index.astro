---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import { getArticles, getArticleNumbers } from '@/lib/content';
import { breadcrumbSchema, collectionSchema, graph, websiteSchema } from '@/lib/seo';

const articles = await getArticles();
const numbers = await getArticleNumbers();
const title = 'Artikel';
const description = 'Alle Langform-Artikel von Dennis Steinmann: ehrliche Einblicke, Zahlen und Learnings aus dem Aufbau von Apps, Software und Unternehmen.';
const crumbs = [{ name: 'Start', path: '/' }, { name: title, path: '/artikel/' }];

// Nach Jahr gruppieren – Archiv-Charakter, über Jahrzehnte lesbar
const byYear = Map.groupBy(articles, (a) => a.data.pubDate.getFullYear());
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={graph(websiteSchema(), breadcrumbSchema(crumbs), collectionSchema('/artikel/', title, description, articles.map((a) => ({ path: `/artikel/${a.id}/`, name: a.data.title }))))}
>
  <PageHeader kicker={`Archiv · ${articles.length} Texte`} title="Lange Texte über <em>kurze</em> Wege." lead="Hier schreibe ich ausführlich darüber, woran ich arbeite: was funktioniert, was scheitert, und welche Zahlen dahinter stehen." crumbs={crumbs} />

  <section class="section">
    <div class="container">
      {articles.length === 0 && <p class="muted">Noch keine Artikel veröffentlicht.</p>}
      {[...byYear].map(([year, list]) => (
        <div class="year">
          <h2 class="year__label display">{year}</h2>
          <div>{list.map((a) => <ArticleCard article={a} number={numbers.get(a.id)} />)}</div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .year { display: grid; grid-template-columns: 1fr 4fr; gap: var(--space-5); }
  .year + .year { margin-top: var(--space-8); }
  .year__label { font-size: var(--step-4); color: var(--fg-subtle); position: sticky; top: 6rem; align-self: start; padding-top: var(--space-5); }
  @media (max-width: 900px) { .year { grid-template-columns: 1fr; } .year__label { position: static; } }
</style>
