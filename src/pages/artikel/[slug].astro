---
import { Image } from 'astro:assets';
import { render, getEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import { mdxComponents } from '@/components/mdx';
import portrait from '@/assets/brand/portrait.jpg';
import { PERSON } from '@/site.config';
import {
  type Article, getArticles, getArticleNumbers, getRelated, formatDate, formatNumber, isoDate, readingTime, wordCount, tagLabel,
} from '@/lib/content';
import { articleSchema, breadcrumbSchema, faqSchema, graph, personSchema, websiteSchema } from '@/lib/seo';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

const { article } = Astro.props as { article: Article };
const { data } = article;
const { Content, headings } = await render(article);
const numbers = await getArticleNumbers();
const num = numbers.get(article.id);
const related = await getRelated(article);
const project = data.project ? await getEntry(data.project) : undefined;
const path = `/artikel/${article.id}/`;
const ogImage = `/og/artikel/${article.id}.png`;
const toc = headings.filter((h) => h.depth === 2);
const minutes = readingTime(article.body);

const crumbs = [
  { name: 'Start', path: '/' },
  { name: 'Artikel', path: '/artikel/' },
  { name: data.title, path },
];

const jsonLd = graph(
  websiteSchema(),
  personSchema(),
  articleSchema({
    path, title: data.title, description: data.description, summary: data.summary,
    pubDate: data.pubDate, updated: data.updated, image: ogImage, tags: data.tags.map(tagLabel),
    wordCount: wordCount(article.body),
    projectPath: project ? `/projekte/${project.id}/` : undefined, projectName: project?.data.title,
  }),
  breadcrumbSchema(crumbs),
  ...(data.faq?.length ? [faqSchema(data.faq)] : []),
);
---

<BaseLayout
  title={data.seoTitle ?? data.title}
  description={data.description}
  type="article"
  image={ogImage}
  canonical={data.canonical}
  publishedTime={data.pubDate}
  modifiedTime={data.updated ?? data.pubDate}
  tags={data.tags.map(tagLabel)}
  jsonLd={jsonLd}
  markdownAlt={`/artikel/${article.id}.md`}
>
  <div class="progress" aria-hidden="true"><span></span></div>

  <article class="article" data-pagefind-body>
    <header class="article__head grid-lines">
      <div class="container">
        <Breadcrumbs crumbs={crumbs} />
        <div class="article__kicker mono reveal">
          {num && <span class="article__num">{formatNumber(num)}</span>}
          {project && <a href={`/projekte/${project.id}/`}>Projekt: {project.data.title}</a>}
        </div>
        <h1 class="display h-xl article__title reveal" style="--i:1">{data.title}</h1>
        <dl class="article__meta mono reveal" style="--i:2">
          <div><dt>Veröffentlicht</dt><dd><time datetime={isoDate(data.pubDate)}>{formatDate(data.pubDate)}</time></dd></div>
          {data.updated && <div><dt>Aktualisiert</dt><dd><time datetime={isoDate(data.updated)}>{formatDate(data.updated)}</time></dd></div>}
          <div><dt>Lesezeit</dt><dd>{minutes} {minutes === 1 ? "Minute" : "Minuten"}</dd></div>
          <div><dt>Autor</dt><dd><a href="/ueber/" rel="author">{PERSON.name}</a></dd></div>
        </dl>
      </div>
    </header>

    {data.cover && (
      <div class="container article__cover">
        <Image src={data.cover} alt={data.coverAlt ?? ''} widths={[640, 1024, 1440, 2048]} sizes="(min-width: 1320px) 1320px, 100vw" loading="eager" fetchpriority="high" />
      </div>
    )}

    <div class="container article__layout">
      <div class="article__main">
        <!-- Answer-first: die Kurzfassung ist für Leser UND KI-Systeme gedacht -->
        <section class="summary" aria-labelledby="summary-h">
          <h2 id="summary-h" class="kicker kicker--accent">Kurzfassung</h2>
          <p>{data.summary}</p>
        </section>

        {toc.length > 2 && (
          <details class="toc">
            <summary class="mono">Inhalt · {toc.length} Abschnitte</summary>
            <ol role="list">
              {toc.map((h, i) => <li><a href={`#${h.slug}`}><span class="mono">{String(i + 1).padStart(2, '0')}</span> {h.text}</a></li>)}
            </ol>
          </details>
        )}

        <div class="prose article__body">
          <Content components={mdxComponents} />
        </div>

        {data.keyTakeaways?.length && (
          <section class="takeaways" aria-labelledby="takeaways-h">
            <h2 id="takeaways-h" class="kicker">Das Wichtigste in Kürze</h2>
            <ol role="list">
              {data.keyTakeaways.map((t) => <li>{t}</li>)}
            </ol>
          </section>
        )}

        {data.faq?.length && (
          <section class="faq" aria-labelledby="faq-h">
            <h2 id="faq-h" class="display h-s">Häufige Fragen</h2>
            {data.faq.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </section>
        )}

        <footer class="article__foot">
          <ul class="article__tags" role="list">
            {data.tags.map((t) => <li><a class="tag" href={`/themen/${t}/`}>{tagLabel(t)}</a></li>)}
          </ul>

          <div class="author">
            <Image src={portrait} alt={PERSON.name} width={96} height={96} class="author__img" />
            <div>
              <p class="kicker">Geschrieben von</p>
              <p class="author__name"><a href="/ueber/" rel="author">{PERSON.name}</a></p>
              <p class="muted author__bio">{PERSON.description}</p>
            </div>
          </div>
        </footer>
      </div>
    </div>
  </article>

  {related.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head">
          <span class="section-head__index">→</span>
          <h2 class="display h-m">Weiterlesen</h2>
          <a class="arrow-link" href="/artikel/">Alle Artikel</a>
        </div>
        {related.map((a) => <ArticleCard article={a} number={numbers.get(a.id)} />)}
      </div>
    </section>
  )}
</BaseLayout>

<script>
  const bar = document.querySelector<HTMLElement>('.progress span');
  const body = document.querySelector<HTMLElement>('.article');
  if (bar && body) {
    const update = () => {
      const r = body.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, -r.top / (r.height - innerHeight)));
      bar.style.transform = `scaleX(${p})`;
    };
    update();
    addEventListener('scroll', update, { passive: true });
  }
</script>

<style>
  .progress { position: fixed; top: 0; left: 0; right: 0; height: 2px; z-index: 60; pointer-events: none; }
  .progress span { display: block; height: 100%; background: var(--accent); transform-origin: 0 50%; transform: scaleX(0); }

  .article__head { padding-block: var(--space-7) var(--space-8); }
  .article__head .container > * + * { margin-top: var(--space-5); }
  .article__kicker { display: flex; flex-wrap: wrap; gap: var(--space-5); margin-top: var(--space-8) !important; text-transform: uppercase; letter-spacing: 0.1em; }
  .article__num { color: var(--accent); }
  .article__kicker a { color: var(--fg-muted); text-decoration: none; }
  .article__kicker a:hover { color: var(--accent); }
  .article__title { max-width: 18ch; }
  .article__meta { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-7); padding-top: var(--space-5); border-top: var(--hairline) solid var(--line); }
  .article__meta dt { color: var(--fg-muted); text-transform: uppercase; letter-spacing: 0.1em; }
  .article__meta dd { margin: 0; color: var(--fg); }
  .article__meta a { text-decoration: none; }

  .article__cover :global(img) { width: 100%; max-height: 78vh; object-fit: cover; border: var(--hairline) solid var(--line); }

  .article__layout { padding-top: var(--space-8); }
  .article__main { max-width: var(--measure); margin-inline: auto; }

  .summary { padding: var(--space-5) var(--space-5) var(--space-5) var(--space-5); border: var(--hairline) solid var(--line-strong); background: var(--bg-raised); position: relative; }
  .summary::before { content: ''; position: absolute; left: -1px; top: -1px; width: 2.5rem; height: 3px; background: var(--accent); }
  .summary p { margin-top: var(--space-3); font-size: var(--step-1); line-height: 1.5; color: var(--fg-strong); }

  .toc { margin-top: var(--space-6); border-block: var(--hairline) solid var(--line); }
  .toc summary { padding-block: var(--space-4); cursor: pointer; text-transform: uppercase; letter-spacing: 0.1em; color: var(--fg-muted); list-style: none; display: flex; justify-content: space-between; }
  .toc summary::after { content: '+'; color: var(--accent); }
  .toc[open] summary::after { content: '−'; }
  .toc ol { list-style: none; padding: 0 0 var(--space-4); display: grid; gap: var(--space-2); }
  .toc a { text-decoration: none; color: var(--fg); }
  .toc a:hover { color: var(--accent); }
  .toc .mono { color: var(--fg-subtle); margin-right: 0.5em; }

  .article__body { margin-top: var(--space-7); }
  .article__body > :global(p:first-of-type::first-letter) {
    font-family: var(--font-display); float: left; font-size: 4.6em; line-height: 0.82; padding: 0.06em 0.1em 0 0; color: var(--accent);
  }

  .takeaways { margin-top: var(--space-8); padding: var(--space-6); background: var(--highlight); color: var(--highlight-fg); }
  .takeaways .kicker { color: var(--highlight-fg); opacity: 0.75; }
  .takeaways ol { margin-top: var(--space-4); padding-left: 0; list-style: none; counter-reset: t; display: grid; gap: var(--space-3); }
  .takeaways li { counter-increment: t; display: grid; grid-template-columns: 2.2rem 1fr; font-weight: 550; line-height: 1.45; }
  .takeaways li::before { content: counter(t, decimal-leading-zero); font-family: var(--font-mono); font-size: var(--step--1); padding-top: 0.2em; }

  .faq { margin-top: var(--space-8); }
  .faq h2 { margin-bottom: var(--space-4); }
  .faq details { border-top: var(--hairline) solid var(--line); }
  .faq details:last-child { border-bottom: var(--hairline) solid var(--line); }
  .faq summary { padding-block: var(--space-4); font-weight: 600; cursor: pointer; color: var(--fg-strong); list-style: none; display: flex; justify-content: space-between; gap: var(--space-4); }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: "+"; font-family: var(--font-mono); color: var(--accent); }
  .faq details[open] summary::after { content: "−"; }
  .faq details p { padding-bottom: var(--space-4); color: var(--fg-muted); }

  .article__foot { margin-top: var(--space-8); display: grid; gap: var(--space-6); }
  .article__tags { display: flex; flex-wrap: wrap; gap: var(--space-2); list-style: none; padding: 0; }
  .author { display: grid; grid-template-columns: 96px 1fr; gap: var(--space-5); align-items: center; padding-top: var(--space-6); border-top: var(--hairline) solid var(--line); }
  .author :global(.author__img) { width: 96px; height: 96px; object-fit: cover; border-radius: 50%; filter: grayscale(0.2) contrast(1.05); }
  .author__name { font-family: var(--font-display); font-size: var(--step-2); line-height: 1.1; margin-top: var(--space-1); }
  .author__name a { text-decoration: none; }
  .author__bio { font-size: var(--step--1); margin-top: var(--space-2); }
</style>
