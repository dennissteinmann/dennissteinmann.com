---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import ProjectField from '@/components/ProjectField.astro';
import { getProjects, PROJECT_KIND_LABELS, PROJECT_KIND_PLURAL, type Project } from '@/lib/content';
import { breadcrumbSchema, collectionSchema, graph, websiteSchema } from '@/lib/seo';

const projects = await getProjects();
const title = 'Projekte';
const description = 'Alle Projekte von Dennis Steinmann: iOS-Apps, Software, Websites, Plattformen und Unternehmen – mit Rolle, Zeitraum, Links und Dokumenten.';
const crumbs = [{ name: 'Start', path: '/' }, { name: title, path: '/projekte/' }];
const kinds = [...Map.groupBy(projects, (p) => p.data.kind)].map(([k, list]) => ({ kind: k, n: list.length }));
---

<BaseLayout title={title} description={description} jsonLd={graph(websiteSchema(), breadcrumbSchema(crumbs), collectionSchema('/projekte/', title, description, projects.map((p) => ({ path: `/projekte/${p.id}/`, name: p.data.title }))))}>
  <PageHeader title="Projekte" lead="Alles, was ich gebaut habe und baue – Apps, Software, Websites und Unternehmen. Manche laufen, manche ruhen, alle haben mich etwas gelehrt." crumbs={crumbs}>
    <p class="meta kinds">{kinds.map(({ kind, n }, i) => <>{i > 0 && ' · '}{n} {(n === 1 ? PROJECT_KIND_LABELS : PROJECT_KIND_PLURAL)[kind as Project['data']['kind']]}</>)}</p>
  </PageHeader>
  <section class="wrap space">
    <ProjectField projects={projects} headingLevel="h2" />
  </section>
</BaseLayout>

<style>
  .kinds { margin-top: var(--s-4); }
</style>
