---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Crest from '@/components/Crest.astro';
---

<BaseLayout title="Seite nicht gefunden" description="Diese Seite existiert nicht (mehr). Über die Navigation findest du alle Artikel, Projekte und das Logbuch von Dennis Steinmann." noindex>
  <section class="section nf grid-lines">
    <div class="container">
      <Crest size="5rem" class="nf__crest" />
      <p class="kicker kicker--accent">Fehler 404</p>
      <h1 class="display h-xl">Hier geht's <em>nicht</em> weiter.</h1>
      <p class="lead muted">Die Seite wurde verschoben oder hat nie existiert. Aber jeder Umweg ist ein Schritt – gradatim.</p>
      <div class="nf__links">
        <a class="btn btn--accent" href="/">Zur Startseite</a>
        <a class="btn" href="/artikel/">Alle Artikel</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf .container > * + * { margin-top: var(--space-5); }
  .nf :global(.nf__crest) { color: var(--accent); }
  .nf__links { display: flex; gap: var(--space-3); flex-wrap: wrap; }
</style>
