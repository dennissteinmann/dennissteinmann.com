---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { getTopics, getExplorations, getProjects } from '@/lib/content';
import { breadcrumbSchema, collectionSchema, graph, websiteSchema } from '@/lib/seo';

const topics = await getTopics();
const explorations = await getExplorations();
const projects = await getProjects();
const count = (id: string) =>
  explorations.filter((e) => e.data.topics.some((t) => t.id === id)).length + projects.filter((p) => p.data.topics.some((t) => t.id === id)).length;
const title = 'Themen';
const description = 'Die Themen von Dennis Steinmann: Mobile Apps, künstliche Intelligenz, Unternehmertum, Personal Branding, SEO und KI-Suche – mit Position und Erfahrung.';
const crumbs = [{ name: 'Start', path: '/' }, { name: title, path: '/themen/' }];
---

<BaseLayout title={title} description={description} jsonLd={graph(websiteSchema(), breadcrumbSchema(crumbs), collectionSchema('/themen/', title, description, topics.map((t) => ({ path: `/themen/${t.id}/`, name: t.data.title }))))}>
  <PageHeader title="Themen" lead="Worüber ich nachdenke, wofür ich stehe – und was ich aus eigener Erfahrung dazu sagen kann." crumbs={crumbs} />
  <section class="wrap space">
    <ul role="list" class="topics">
      {topics.map((t) => (
        <li>
          <a href={`/themen/${t.id}/`} class="plain topics__link">
            <span class="display t-xl topics__name">{t.data.title}</span>
            <span class="topics__position">{t.data.position}</span>
            <span class="meta">{count(t.id)} Einträge{t.data.since && ` · seit ${t.data.since}`}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .topics li { border-top: 1px solid var(--line); }
  .topics__link { display: grid; grid-template-columns: 6fr 4fr 2fr; gap: var(--gutter); padding-block: var(--s-5); align-items: baseline; }
  .topics__name { line-height: 1; transition: opacity var(--fast); }
  .topics__position { color: var(--grey); font-style: italic; }
  .topics__link .meta { text-align: right; }
  .topics__link:hover .topics__name { opacity: 0.5; }
  @media (max-width: 900px) { .topics__link { grid-template-columns: 1fr; gap: var(--s-2); } .topics__link .meta { text-align: left; } }
</style>
