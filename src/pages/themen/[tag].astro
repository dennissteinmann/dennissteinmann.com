---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { getAllTags, getArticles, getArticleNumbers, getProjects, tagLabel } from '@/lib/content';
import { breadcrumbSchema, collectionSchema, graph, websiteSchema } from '@/lib/seo';

export async function getStaticPaths() {
  return (await getAllTags()).map(({ tag }) => ({ params: { tag } }));
}

const { tag } = Astro.params as { tag: string };
const label = tagLabel(tag);
const articles = (await getArticles()).filter((a) => a.data.tags.includes(tag));
const projects = (await getProjects()).filter((p) => p.data.tags.includes(tag));
const numbers = await getArticleNumbers();
const path = `/themen/${tag}/`;
const description = `Alle Artikel und Projekte von Dennis Steinmann zum Thema ${label}: Erfahrungen, Zahlen und Learnings aus der Praxis.`;
const crumbs = [{ name: 'Start', path: '/' }, { name: 'Themen', path: '/themen/' }, { name: label, path }];
// Themen mit nur einem Eintrag sind "dünn" → noindex, aber follow (siehe docs/SEO.md)
const thin = articles.length + projects.length < 2;
---

<BaseLayout
  title={`${label} – Themen`}
  description={description}
  noindex={thin}
  jsonLd={graph(websiteSchema(), breadcrumbSchema(crumbs), collectionSchema(path, label, description, articles.map((a) => ({ path: `/artikel/${a.id}/`, name: a.data.title }))))}
>
  <PageHeader kicker={`Thema · ${articles.length + projects.length} Einträge`} title={label} crumbs={crumbs} />
  {articles.length > 0 && (
    <section class="section"><div class="container">
      <div class="section-head"><span class="section-head__index">01</span><h2 class="display h-m">Artikel</h2><span></span></div>
      {articles.map((a) => <ArticleCard article={a} number={numbers.get(a.id)} />)}
    </div></section>
  )}
  {projects.length > 0 && (
    <section class="section"><div class="container">
      <div class="section-head"><span class="section-head__index">02</span><h2 class="display h-m">Projekte</h2><span></span></div>
      <div class="pgrid">{projects.map((p, i) => <ProjectCard project={p} index={i} />)}</div>
    </div></section>
  )}
</BaseLayout>

<style>
  .pgrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr)); gap: var(--space-4); }
</style>
