---
/**
 * Social-Kit je Exploration: /social/<slug>/  (noindex, per robots.txt gesperrt)
 * Carousel-Folien, Link-Vorschau und fertiger Post-Text. Übersicht: /studio/
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { type Exploration, getExplorations } from '@/lib/content';
import { getSlides, getCaption } from '@/lib/social';

export async function getStaticPaths() {
  return (await getExplorations()).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: Exploration };
const slides = getSlides(entry);
const caption = await getCaption(entry);
const base = `/social/${entry.id}`;
---

<BaseLayout title={`Social-Kit: ${entry.data.title}`} description="Internes Social-Media-Kit: Carousel-Folien, Vorschaubild und Post-Text zu einer Exploration auf dennissteinmann.com." noindex>
  <PageHeader title={entry.data.title} lead="Social-Kit. Folien laden, Text kopieren, posten – und danach in der Exploration unter distribution eintragen." crumbs={[{ name: 'Studio', path: '/studio/' }, { name: entry.data.title, path: `${base}/` }]} />

  <section class="wrap space">
    <ol class="slides" role="list">
      {slides.map((_, i) => (
        <li>
          <a href={`${base}/${i + 1}.png`} download={`${entry.id}-${String(i + 1).padStart(2, '0')}.png`} class="plain">
            <img src={`${base}/${i + 1}.png`} alt={`Folie ${i + 1}`} width="1080" height="1350" loading="lazy" />
          </a>
          <span class="meta">{i + 1} · herunterladen</span>
        </li>
      ))}
    </ol>
  </section>

  <section class="wrap space kit">
    <div>
      <div class="kit__head"><h2 class="display t-m">Post-Text</h2><button class="link" type="button" data-copy>Kopieren</button></div>
      <pre class="caption" data-caption>{caption}</pre>
    </div>
    <div>
      <h2 class="display t-m kit__head">Link-Vorschau</h2>
      <img src={`/og/explorationen/${entry.id}.png`} alt="Vorschaubild" width="1200" height="630" class="og" />
    </div>
  </section>
</BaseLayout>

<script>
  document.querySelector('[data-copy]')?.addEventListener('click', async (e) => {
    await navigator.clipboard.writeText(document.querySelector('[data-caption]')?.textContent ?? '');
    (e.currentTarget as HTMLButtonElement).textContent = 'Kopiert';
  });
</script>

<style>
  .slides { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: var(--s-4); }
  .slides li { display: grid; gap: var(--s-2); }
  .slides img { width: 100%; height: auto; outline: 1px solid var(--line); }
  .kit { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-6); }
  .kit__head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: var(--s-4); }
  .caption { white-space: pre-wrap; font-family: var(--serif); font-size: var(--t-body); line-height: 1.5; }
  .og { width: 100%; height: auto; outline: 1px solid var(--line); }
  @media (max-width: 900px) { .kit { grid-template-columns: 1fr; } }
</style>
