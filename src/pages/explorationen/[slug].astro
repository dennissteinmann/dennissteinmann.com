---
import { Image } from 'astro:assets';
import { render, getEntries } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ExplorationList from '@/components/ExplorationList.astro';
import { mdxComponents } from '@/components/mdx';
import portrait from '@/assets/brand/portrait.jpg';
import { PERSON } from '@/site.config';
import {
  type Exploration, getExplorations, getRelated, formatDate, isoDate, readingTime, wordCount, minutesLabel, KIND_LABELS, STAGE_LABELS,
} from '@/lib/content';
import { articleSchema, breadcrumbSchema, faqSchema, graph, personSchema, websiteSchema } from '@/lib/seo';

export async function getStaticPaths() {
  return (await getExplorations()).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: Exploration };
const d = entry.data;
const { Content, headings } = await render(entry);
const topics = await getEntries(d.topics);
const projects = await getEntries(d.projects);
const related = await getRelated(entry);
const path = `/explorationen/${entry.id}/`;
const ogImage = `/og/explorationen/${entry.id}.png`;
const toc = headings.filter((h) => h.depth === 2);
const crumbs = [{ name: 'Start', path: '/' }, { name: 'Explorationen', path: '/explorationen/' }, { name: d.title, path }];

const jsonLd = graph(
  websiteSchema(),
  await personSchema(),
  articleSchema({
    path, title: d.title, description: d.description, summary: d.summary, pubDate: d.pubDate, updated: d.updated,
    image: ogImage, topics: topics.map((t) => ({ name: t.data.title, path: `/themen/${t.id}/` })),
    wordCount: wordCount(entry.body), genre: KIND_LABELS[d.kind], citations: d.sources,
    distributed: d.distribution.flatMap((x) => (x.url ? [x.url] : [])),
  }),
  breadcrumbSchema(crumbs),
  ...(d.faq?.length ? [faqSchema(d.faq)] : []),
);
---

<BaseLayout
  title={d.seoTitle ?? d.title}
  description={d.description}
  type="article"
  image={ogImage}
  canonical={d.canonical}
  publishedTime={d.pubDate}
  modifiedTime={d.updated ?? d.pubDate}
  tags={topics.map((t) => t.data.title)}
  jsonLd={jsonLd}
  markdownAlt={`/explorationen/${entry.id}.md`}
>
  <article>
    <header class="wrap head">
      <h1 class="display t-xl head__title">{d.title}</h1>
      <div class="head__meta meta">
        <p>{KIND_LABELS[d.kind]} von <a href="/ueber/" rel="author">{PERSON.name}</a></p>
        <p><time datetime={isoDate(d.pubDate)}>{formatDate(d.pubDate)}</time>{d.updated && <>, überarbeitet <time datetime={isoDate(d.updated)}>{formatDate(d.updated)}</time></>}</p>
        <p>{minutesLabel(readingTime(entry.body))} · {STAGE_LABELS[d.stage]}</p>
        <p>{topics.map((t, i) => <>{i > 0 && ', '}<a href={`/themen/${t.id}/`}>{t.data.title}</a></>)}</p>
      </div>
    </header>

    {d.cover && (
      <figure class="wrap cover">
        <Image src={d.cover} alt={d.coverAlt ?? ''} widths={[640, 1024, 1440, 2048]} sizes="100vw" loading="eager" fetchpriority="high" />
      </figure>
    )}

    <div class="wrap body">
      <!-- Answer-first: These / Kurzfassung – für Leser und KI-Systeme -->
      <p class="summary">{d.summary}</p>

      {toc.length > 2 && (
        <nav class="toc meta" aria-label="Inhalt">
          <ol role="list">{toc.map((h) => <li><a class="plain" href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </nav>
      )}

      <div class="prose"><Content components={mdxComponents} /></div>

      {d.keyTakeaways?.length && (
        <section class="block" aria-labelledby="kt">
          <h2 id="kt" class="display t-m">Kurz gesagt</h2>
          <ol class="takeaways">{d.keyTakeaways.map((t) => <li>{t}</li>)}</ol>
        </section>
      )}

      {d.faq?.length && (
        <section class="block" aria-labelledby="faq">
          <h2 id="faq" class="display t-m">Fragen</h2>
          <dl class="faq">{d.faq.map((f) => <div><dt>{f.q}</dt><dd>{f.a}</dd></div>)}</dl>
        </section>
      )}

      {d.sources.length > 0 && (
        <section class="block" aria-labelledby="src">
          <h2 id="src" class="display t-m">Quellen</h2>
          <ol class="sources sans">{d.sources.map((s) => <li><a href={s.url} rel="noopener">{s.title}</a></li>)}</ol>
        </section>
      )}

      {d.changelog.length > 0 && (
        <section class="block" aria-labelledby="log">
          <h2 id="log" class="display t-m">Entwicklung dieses Gedankens</h2>
          <ol class="changelog meta">{d.changelog.map((c) => <li><time datetime={isoDate(c.date)}>{formatDate(c.date)}</time> — {c.note}</li>)}</ol>
        </section>
      )}

      <footer class="author">
        <Image src={portrait} alt="" width={72} height={72} class="author__img" />
        <p class="sans"><a href="/ueber/" rel="author">{PERSON.name}</a><br /><span class="muted">{PERSON.jobTitle}</span></p>
      </footer>

      {projects.length > 0 && (
        <p class="meta projects">Gehört zu: {projects.map((p, i) => <>{i > 0 && ', '}<a href={`/projekte/${p.id}/`}>{p.data.title}</a></>)}</p>
      )}
    </div>
  </article>

  {related.length > 0 && (
    <section class="wrap space">
      <h2 class="display t-m related__h">Weiterdenken</h2>
      <ExplorationList items={related} />
    </section>
  )}

  <div class="wrap"><Breadcrumbs crumbs={crumbs} /></div>
</BaseLayout>

<style>
  .head { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); padding-top: var(--s-7); padding-bottom: var(--s-6); align-items: end; }
  .head__title { grid-column: 1 / span 9; max-width: 13em; }
  .head__meta { grid-column: 10 / span 3; display: grid; gap: 0.15rem; }
  .head__meta a { color: inherit; }

  .cover { margin-bottom: var(--s-6); }
  .cover :global(img) { width: 100%; max-height: 82vh; object-fit: cover; }

  .body > * { max-width: var(--measure); margin-inline: auto; }
  .summary { font-size: var(--t-m); line-height: 1.4; padding-block: var(--s-5) var(--s-6); }
  .toc { margin-bottom: var(--s-6); }
  .toc ol { display: grid; gap: 0.2rem; counter-reset: toc; }
  .toc li { counter-increment: toc; }
  .toc li::before { content: counter(toc) '  '; color: var(--grey-light); }
  .toc a { color: var(--grey); }
  .toc a:hover { color: var(--ink); }

  .body > .prose > :global(p:first-child::first-letter) { font-size: 3.4em; float: left; line-height: 0.85; padding: 0.06em 0.08em 0 0; }

  .block { margin-top: var(--s-7); }
  .block h2 { margin-bottom: var(--s-4); }
  .takeaways { padding-left: 1.2em; display: grid; gap: var(--s-2); }
  .takeaways li::marker { font-family: var(--sans); font-size: 0.75em; color: var(--grey); }
  .faq { display: grid; gap: var(--s-4); }
  .faq dt { font-style: italic; }
  .faq dd { margin: var(--s-1) 0 0; color: var(--ink-soft); }
  .sources { padding-left: 1.2em; display: grid; gap: var(--s-1); }
  .changelog { display: grid; gap: var(--s-1); }

  .author { display: flex; align-items: center; gap: var(--s-3); margin-top: var(--s-7) !important; padding-top: var(--s-5); border-top: 1px solid var(--line); }
  .author :global(.author__img) { width: 72px; height: 72px; object-fit: cover; border-radius: 50%; }
  .author a { text-decoration: none; }
  .projects { margin-top: var(--s-4) !important; }
  .projects a { color: inherit; }

  .related__h { margin-bottom: var(--s-4); }

  @media (max-width: 900px) {
    .head { grid-template-columns: 1fr; }
    .head__title, .head__meta { grid-column: 1; }
    .head__meta { margin-top: var(--s-4); }
  }
</style>
