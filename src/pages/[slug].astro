---
/** Freie Unterseiten aus src/content/pages/*.mdx → /<dateiname>/ */
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { mdxComponents } from '@/components/mdx';
import { type Page, getPages, formatDate, DEDICATED_PAGES } from '@/lib/content';
import { abs, breadcrumbSchema, graph, websiteSchema } from '@/lib/seo';

export async function getStaticPaths() {
  return (await getPages()).filter((p) => !DEDICATED_PAGES.includes(p.id)).map((page) => ({ params: { slug: page.id }, props: { page } }));
}

const { page } = Astro.props as { page: Page };
const d = page.data;
const { Content } = await render(page);
const path = `/${page.id}/`;
const crumbs = [{ name: 'Start', path: '/' }, { name: d.title, path }];
---

<BaseLayout title={d.seoTitle ?? d.title} description={d.description} noindex={d.noindex}
  jsonLd={graph(websiteSchema(), breadcrumbSchema(crumbs), { '@type': d.schemaType, url: abs(path), name: d.title, description: d.description })}>
  <PageHeader title={d.title} crumbs={crumbs} />
  <section class="wrap space-b">
    <div class="prose body"><Content components={mdxComponents} /></div>
    {d.updated && <p class="meta body updated">Stand: {formatDate(d.updated)}</p>}
  </section>
</BaseLayout>

<style>
  .body { margin-left: calc(100% / 12 * 3); }
  .updated { margin-top: var(--s-6); }
  @media (max-width: 900px) { .body { margin-left: 0; } }
</style>
