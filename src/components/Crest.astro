---
/** Das Wappen (Löwe, Kreuz, Lilien). Übernimmt currentColor. */
import crest from '@/assets/brand/crest.svg?raw';

export interface Props {
  size?: string;
  class?: string;
  label?: string;
}
const { size = '1.6rem', class: className, label } = Astro.props;
const svg = crest.replace('<svg ', `<svg ${label ? `role="img" aria-label="${label}"` : 'aria-hidden="true"'} `);
---

<span class:list={['crest', className]} style={`--crest-size:${size}`} set:html={svg} />

<style>
  .crest { display: inline-block; width: calc(var(--crest-size) * 0.78); height: var(--crest-size); flex: none; }
  .crest :global(svg) { width: 100%; height: 100%; }
</style>
