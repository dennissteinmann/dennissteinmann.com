---
import { NAV, FOOTER_NAV, SITE, PERSON, activeChannels } from '@/site.config';
import Crest from './Crest.astro';

const year = new Date().getFullYear();
const channels = activeChannels();
---

<footer class="footer stage stage--navy">
  <div class="wrap">
    <div class="footer__grid">
      <div class="footer__mark">
        <Crest size="3.4rem" class="footer__crest" />
        <p class="footer__id">
          <span class="mark">{SITE.name}</span>
          <span class="meta">{PERSON.jobTitle}<br />{PERSON.homeLocation}</span>
        </p>
      </div>
      <div class="footer__col">
        <p class="label footer__h">Verzeichnis</p>
        <ul role="list">
          {NAV.map((n) => <li><a class="plain" href={n.href}>{n.label}</a></li>)}
        </ul>
      </div>
      <div class="footer__col">
        <p class="label footer__h">Weiteres</p>
        <ul role="list">
          {FOOTER_NAV.map((n) => <li><a class="plain" href={n.href}>{n.label}</a></li>)}
        </ul>
      </div>
      {channels.length > 0 && (
        <div class="footer__col">
          <p class="label footer__h">Profile</p>
          <ul role="list">
            {channels.map((c) => <li><a class="plain" href={c.url} rel="me noopener">{c.name}</a></li>)}
          </ul>
        </div>
      )}
    </div>
    <div class="footer__base meta">
      <p>© {year} {SITE.name}</p>
      <p>{SITE.url.replace('https://', '')}</p>
    </div>
  </div>
</footer>

<style>
  .footer { margin-top: var(--s-8); padding-block: var(--s-7) var(--s-4); }
  .footer__grid { display: grid; grid-template-columns: 6fr 2fr 2fr 2fr; gap: var(--gutter); }
  .footer__mark { display: flex; gap: var(--s-4); align-items: flex-start; }
  .footer__mark :global(.footer__crest) { color: var(--accent); }
  .footer__id { display: grid; gap: var(--s-3); }
  .footer__id .mark { font-size: var(--t-m); }
  .footer__h { color: var(--fg-muted); padding-bottom: var(--s-2); margin-bottom: var(--s-3); border-bottom: 1px solid var(--line); }
  .footer ul { display: grid; gap: var(--s-2); align-content: start; }
  .footer ul a { font-family: var(--font); font-size: var(--t-body); color: var(--fg); line-height: 1.3; }
  .footer ul a:hover { text-decoration: underline; text-decoration-color: var(--accent); }
  .footer__base { display: flex; justify-content: space-between; gap: var(--s-4); margin-top: var(--s-7); padding-top: var(--s-3); border-top: 1px solid var(--line); }
  @media (max-width: 860px) {
    .footer__grid { grid-template-columns: 1fr 1fr; row-gap: var(--s-6); }
    .footer__mark { grid-column: 1 / -1; }
  }
</style>
