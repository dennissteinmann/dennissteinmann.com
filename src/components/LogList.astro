---
import { render } from 'astro:content';
import { type LogEntry, formatDate, isoDate } from '@/lib/content';
import { mdxComponents } from './mdx';

export interface Props { entries: LogEntry[]; projectNames?: Map<string, string>; headingLevel?: 'h2' | 'h3' }
const { entries, projectNames, headingLevel: H = 'h2' } = Astro.props;
const rendered = await Promise.all(entries.map(async (e) => ({ e, Content: (await render(e)).Content })));
---

<ol class="log" role="list">
  {rendered.map(({ e, Content }) => (
    <li class="log__item" id={`log-${e.id.split('/').pop()}`}>
      <p class="meta">
        <time datetime={isoDate(e.data.date)}>{formatDate(e.data.date)}</time>
        {e.data.project && projectNames?.get(e.data.project.id) && (
          <> · <a href={`/projekte/${e.data.project.id}/`}>{projectNames.get(e.data.project.id)}</a></>
        )}
      </p>
      <div>
        <H class="log__title">{e.data.title}</H>
        <div class="prose log__text"><Content components={mdxComponents} /></div>
        {e.data.exploration && <p class="log__more"><a class="link" href={`/explorationen/${e.data.exploration.id}/`}>Weiterlesen</a></p>}
      </div>
    </li>
  ))}
</ol>

<style>
  .log__item { display: grid; grid-template-columns: 3fr 9fr; gap: var(--gutter); padding-block: var(--s-5); border-top: 1px solid var(--line); scroll-margin-top: 4rem; }
  .log__item .meta a { color: var(--grey); }
  .log__title { font-size: var(--t-m); line-height: 1.2; }
  .log__text { margin-top: var(--s-2); color: var(--ink-soft); }
  .log__more { margin-top: var(--s-3); }
  @media (max-width: 760px) { .log__item { grid-template-columns: 1fr; gap: var(--s-2); } }
</style>
