---
/**
 * Projektkarte. Das Erscheinungsbild folgt der Art des Projekts:
 *  app          → farbige Fläche (Projektfarbe) mit App-Icon, wie ein Objekt auf einem Sockel
 *  website/software/plattform → Bildschirm-Ausschnitt (cover) oder Domain als Typografie
 *  unternehmen  → reine Typografie, Name als Wortmarke
 *  medien/forschung → Hochformat wie ein Buch- oder Plakatcover
 * `uniform` setzt alle Varianten auf ein gemeinsames Hochformat (Raster, Register).
 * Projektfarbe (`color`) gehört dem Projekt – die Website selbst bleibt Papier/Tinte.
 * Rechtwinklig, ohne Schatten (docs/DESIGN.md §2).
 */
import { Image } from 'astro:assets';
import { type Project, PROJECT_KIND_LABELS, STATUS_LABELS, projectYears } from '@/lib/content';

export interface Props { project: Project; headingLevel?: 'h2' | 'h3'; sizes?: string; uniform?: boolean }
const { project, headingLevel: H = 'h3', sizes = '(min-width: 900px) 40vw, 90vw', uniform = false } = Astro.props;
const d = project.data;
const href = `/projekte/${project.id}/`;
const domain = d.url ? new URL(d.url).hostname.replace(/^www\./, '') : undefined;
const variant =
  d.kind === 'app' ? 'object' :
  d.kind === 'unternehmen' ? 'type' :
  d.kind === 'medien' || d.kind === 'forschung' ? 'cover' : 'screen';
const statusNote = d.status === 'aktiv' ? '' : ` · ${STATUS_LABELS[d.status]}`;
const style = d.color ? `--pc:${d.color}` : '';
---

<article class:list={['pc', `pc--${variant}`, { 'pc--colored': !!d.color, 'pc--draft': d.draft, 'pc--uniform': uniform }]} style={style}>
  <a href={href} class="pc__stage plain" aria-label={d.title} tabindex="-1">
    {variant === 'object' && (
      d.icon
        ? <Image src={d.icon} alt="" width={240} height={240} class="pc__icon" />
        : <span class="pc__glyph display">{d.title.charAt(0)}</span>
    )}
    {variant === 'screen' && (
      d.cover
        ? <Image src={d.cover} alt={d.coverAlt ?? ''} widths={[480, 800, 1200]} sizes={sizes} class="pc__img" />
        : d.icon
          ? <Image src={d.icon} alt="" width={200} height={200} class="pc__icon pc__icon--flat" />
          : <span class="pc__domain display">{(domain ?? d.title).split('.').map((part, i) => <>{i > 0 && <>.<wbr /></>}{part}</>)}</span>
    )}
    {variant === 'type' && <span class="pc__word mark">{d.title}</span>}
    {variant === 'cover' && (
      d.cover
        ? <Image src={d.cover} alt={d.coverAlt ?? ''} widths={[400, 700]} sizes={sizes} class="pc__img" />
        : <span class="pc__booktitle display">{d.title}</span>
    )}
  </a>
  <div class="pc__caption">
    <H class="pc__title"><a href={href} class="plain">{d.title}</a></H>
    <p class="meta">{PROJECT_KIND_LABELS[d.kind]} · {projectYears(project)}{statusNote}{d.draft && ' · Entwurf'}</p>
  </div>
</article>

<style>
  .pc { --pc: var(--placeholder); display: flex; flex-direction: column; gap: var(--s-3); }
  .pc__stage { position: relative; display: grid; place-items: center; overflow: hidden; background: var(--pc); outline: 1px solid var(--line); outline-offset: -1px; }
  .pc__stage :global(img.pc__img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1.6s var(--ease); }
  .pc:hover .pc__stage :global(img.pc__img) { transform: scale(1.015); }

  /* App: Objekt auf farbiger Fläche – rechtwinklig, ohne Schatten */
  .pc--object .pc__stage { aspect-ratio: 1; }
  .pc__stage :global(.pc__icon) { width: 34%; height: auto; }
  .pc__stage :global(.pc__icon--flat) { width: 28%; }
  .pc__glyph { font-size: clamp(4rem, 10vw, 9rem); color: var(--white); mix-blend-mode: difference; }
  .pc--object:not(.pc--colored) .pc__glyph { color: var(--ink); mix-blend-mode: normal; }

  /* Website/Software: Bildschirm */
  .pc--screen .pc__stage { aspect-ratio: 16 / 10; }
  .pc__domain { font-size: clamp(1.4rem, 2.2vw, 2.2rem); padding: var(--s-4); text-align: center; overflow-wrap: break-word; min-width: 0; max-width: 100%; }
  .pc--screen:not(.pc--colored) .pc__stage, .pc--type:not(.pc--colored) .pc__stage { background: var(--white); }
  .pc--colored .pc__domain { color: var(--white); }

  /* Unternehmen: Wortmarke in gesperrten Versalien, wie ein Firmenschild */
  .pc--type .pc__stage { aspect-ratio: 5 / 3; }
  .pc__word { font-size: clamp(1.1rem, 1.7vw, 1.6rem); padding: var(--s-4); text-align: center; line-height: 1.3; color: var(--ink); }
  .pc--type.pc--colored .pc__word { color: var(--white); }

  /* Medien/Forschung: Cover im Hochformat */
  .pc--cover .pc__stage { aspect-ratio: 3 / 4; place-items: end start; }
  .pc__booktitle { font-size: clamp(1.5rem, 2.2vw, 2.2rem); line-height: 1.08; padding: var(--s-4); color: var(--ivory); font-weight: var(--w-medium); }
  .pc--cover:not(.pc--colored) .pc__stage { background: var(--navy); }

  /* Register-Format: gemeinsames Hochformat für Raster und Galerien */
  .pc--uniform .pc__stage { aspect-ratio: 4 / 5; }
  .pc--uniform .pc__domain { font-size: clamp(1.05rem, 0.8rem + 0.9vw, 1.6rem); padding: var(--s-3); }

  .pc__title { font-family: var(--font); font-size: var(--t-body); line-height: 1.25; }
  .pc__title a { text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 0.2em; }
  .pc:hover .pc__title a { text-decoration-color: var(--accent); }
  .pc__caption .meta { margin-top: 0.2rem; }
  .pc--draft { opacity: 0.55; }
</style>
