---
import { Image } from 'astro:assets';
import { type Article, formatDate, formatNumber, isoDate, readingTime, tagLabel } from '@/lib/content';

export interface Props {
  article: Article;
  number?: number;
  variant?: 'row' | 'feature';
  headingLevel?: 'h2' | 'h3';
}
const { article, number, variant = 'row', headingLevel: H = 'h3' } = Astro.props;
const { data } = article;
const href = `/artikel/${article.id}/`;
---

<article class:list={['card', `card--${variant}`]}>
  <div class="card__meta mono">
    {number && <span class="card__num">{formatNumber(number)}</span>}
    <time datetime={isoDate(data.pubDate)}>{formatDate(data.pubDate)}</time>
    <span>{readingTime(article.body)} Min.</span>
    {data.draft && <span class="highlight">Entwurf</span>}
  </div>
  <div class="card__body">
    <H class="card__title display"><a href={href}>{data.title}</a></H>
    <p class="card__desc">{data.description}</p>
    <ul class="card__tags" role="list">
      {data.tags.slice(0, 3).map((t) => <li class="tag">{tagLabel(t)}</li>)}
    </ul>
  </div>
  {variant === 'feature' && data.cover && (
    <div class="card__media">
      <Image src={data.cover} alt={data.coverAlt ?? ''} widths={[480, 800, 1200]} sizes="(min-width: 900px) 45vw, 100vw" />
    </div>
  )}
</article>

<style>
  .card { position: relative; display: grid; grid-template-columns: minmax(9rem, 1fr) 3fr; gap: var(--space-5); padding-block: var(--space-6); border-top: var(--hairline) solid var(--line); }
  .card__meta { display: flex; flex-direction: column; gap: var(--space-1); color: var(--fg-muted); }
  .card__num { color: var(--accent); }
  .card__title { font-size: var(--step-3); line-height: 1.05; }
  .card__title a { text-decoration: none; background: linear-gradient(var(--accent), var(--accent)) 0 100% / 0 1px no-repeat; transition: background-size var(--dur-3) var(--ease-out); }
  .card__title a::after { content: ''; position: absolute; inset: 0; }
  .card:hover .card__title a { background-size: 100% 1px; color: var(--fg-strong); }
  .card__desc { margin-top: var(--space-3); color: var(--fg-muted); max-width: 62ch; }
  .card__tags { display: flex; flex-wrap: wrap; gap: var(--space-2); list-style: none; padding: 0; margin-top: var(--space-4); }

  .card--feature { grid-template-columns: 1fr 1fr; align-items: center; border-top: 0; padding-top: 0; }
  .card--feature .card__meta { grid-column: 1 / -1; flex-direction: row; gap: var(--space-4); }
  .card--feature .card__title { font-size: var(--step-4); }
  .card--feature:not(:has(.card__media)) .card__body { grid-column: 1 / -1; }
  .card--feature:not(:has(.card__media)) .card__title { font-size: var(--step-5); max-width: 20ch; }
  .card__media { overflow: hidden; border: var(--hairline) solid var(--line); }
  .card__media :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; transition: transform 1.2s var(--ease-out); }
  .card:hover .card__media :global(img) { transform: scale(1.03); }

  @media (max-width: 760px) {
    .card, .card--feature { grid-template-columns: 1fr; gap: var(--space-3); }
    .card__meta { flex-direction: row; gap: var(--space-4); }
  }
</style>
