---
/** Kopf jeder Übersichts-/Unterseite: viel Luft, ein Titel, optional ein Satz. */
import Breadcrumbs from './Breadcrumbs.astro';
import type { Crumb } from '@/lib/seo';

export interface Props { title: string; lead?: string; crumbs?: Crumb[] }
const { title, lead, crumbs } = Astro.props;
---

<header class="ph wrap">
  <h1 class="display t-xl" set:html={title} />
  {lead && <p class="lead ph__lead">{lead}</p>}
  <slot />
  {crumbs && <Breadcrumbs crumbs={crumbs} />}
</header>

<style>
  .ph { padding-top: var(--s-7); padding-bottom: var(--s-6); }
  .ph h1 { max-width: 14em; }
  .ph__lead { margin-top: var(--s-4); color: var(--ink-soft); }
  .ph :global(.breadcrumbs) { margin-top: var(--s-5); }
</style>
