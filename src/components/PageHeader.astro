---
/** Einheitlicher Kopf für Übersichts- und Unterseiten. */
import Breadcrumbs from './Breadcrumbs.astro';
import type { Crumb } from '@/lib/seo';

export interface Props {
  kicker?: string;
  title: string;
  lead?: string;
  crumbs?: Crumb[];
}
const { kicker, title, lead, crumbs } = Astro.props;
---

<header class="page-header grid-lines">
  <div class="container">
    {crumbs && <Breadcrumbs crumbs={crumbs} />}
    {kicker && <p class="kicker kicker--accent reveal">{kicker}</p>}
    <h1 class="display h-xl reveal" style="--i:1" set:html={title} />
    {lead && <p class="lead reveal" style="--i:2">{lead}</p>}
    <slot />
  </div>
</header>

<style>
  .page-header { padding-block: var(--space-8) var(--space-8); border-bottom: var(--hairline) solid var(--line); }
  .page-header .container > * + * { margin-top: var(--space-5); }
  .page-header h1 { max-width: 16ch; }
  .page-header .kicker { margin-top: var(--space-7); }
</style>
