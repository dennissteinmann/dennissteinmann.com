---
/** Kennzahlen, typografisch. <Stats items={[{ value: '300.000', label: 'Downloads / Monat' }]} /> */
export interface Props { items: { value: string; label: string }[] }
const { items } = Astro.props;
---

<dl class="stats">
  {items.map((it) => (
    <div class="stats__item">
      <dt>{it.label}</dt>
      <dd>{it.value}</dd>
    </div>
  ))}
</dl>

<style>
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: var(--s-4); margin-block: 2.4em; }
  .stats__item { display: flex; flex-direction: column-reverse; justify-content: flex-end; padding-top: var(--s-3); border-top: 1px solid var(--ink); }
  .stats dd { font-family: var(--serif); font-size: var(--t-l); line-height: 1; letter-spacing: -0.02em; font-variant-numeric: lining-nums tabular-nums; margin: 0; }
  .stats dt { font-family: var(--sans); font-size: var(--t-xs); color: var(--grey); margin-top: var(--s-2); }
</style>
