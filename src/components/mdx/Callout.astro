---
/** Hervorgehobener Gedanke. <Callout title="Learning">Text</Callout> */
export interface Props { title?: string; type?: string }
const { title } = Astro.props;
---

<aside class="callout">
  {title && <p class="callout__title">{title}</p>}
  <div class="callout__body"><slot /></div>
</aside>

<style>
  .callout { margin-block: 2.4em; padding-left: var(--s-4); border-left: 1px solid var(--ink); }
  .callout__title { font-family: var(--sans); font-size: var(--t-xs); color: var(--grey); margin-bottom: var(--s-1); }
  .callout__body { font-style: italic; }
  .callout__body > :global(* + *) { margin-top: 0.8em; }
</style>
