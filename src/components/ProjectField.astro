---
/**
 * Projektfeld: strenges Register-Raster. Gleiche Zellen, gleiche Formate,
 * klare Reihenfolge – wie ein Katalog. Ordnung schafft Vertrauen (v4 „Kontor“).
 */
import ProjectCard from './ProjectCard.astro';
import type { Project } from '@/lib/content';

export interface Props { projects: Project[]; headingLevel?: 'h2' | 'h3' }
const { projects, headingLevel = 'h3' } = Astro.props;
---

<div class="field">
  {projects.map((project) => (
    <div class="field__item">
      <ProjectCard project={project} headingLevel={headingLevel} uniform sizes="(min-width: 1100px) 22vw, (min-width: 760px) 30vw, 45vw" />
    </div>
  ))}
</div>

<style>
  .field { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); column-gap: var(--gutter); row-gap: var(--s-6); align-items: start; }
  @media (max-width: 1100px) { .field { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 760px) { .field { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: var(--s-5); } }
</style>
