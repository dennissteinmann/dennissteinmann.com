---
import { NAV, SITE } from '@/site.config';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<header class="header">
  <div class="wrap header__inner">
    <a href="/" class="header__name sans plain" aria-label={`${SITE.name} – Startseite`}>{SITE.name}</a>

    <nav class="header__nav" aria-label="Hauptnavigation" id="nav">
      <ul role="list">
        {NAV.map((item) => (
          <li><a href={item.href} class="sans plain" aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <button class="header__toggle sans" type="button" aria-expanded="false" aria-controls="nav" data-menu>Menü</button>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu]');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    btn.textContent = open ? 'Menü' : 'Schließen';
    document.documentElement.classList.toggle('menu-open', !open);
  });
</script>

<style>
  .header { position: sticky; top: 0; z-index: 50; background: var(--bg); border-bottom: 1px solid var(--line); }
  .header__inner { display: flex; align-items: center; justify-content: space-between; gap: var(--s-4); padding-block: var(--s-3); }
  .header__name { font-family: var(--grotesk); font-weight: 650; text-transform: uppercase; letter-spacing: 0.04em; font-size: var(--t-s); color: var(--ink); }

  .header__nav ul { display: flex; gap: clamp(1rem, 2.2vw, 2.25rem); }
  .header__nav a { font-family: var(--grotesk); text-transform: uppercase; letter-spacing: var(--track-caps); font-size: var(--t-xs); color: var(--grey); transition: color var(--fast); }
  .header__nav a:hover, .header__nav a[aria-current='page'] { color: var(--ink); }

  .header__toggle { display: none; font-family: var(--grotesk); text-transform: uppercase; letter-spacing: var(--track-caps); font-size: var(--t-xs); }

  @media (max-width: 860px) {
    .header__toggle { display: block; }
    .header__nav {
      position: fixed; inset: 0; z-index: -1; background: var(--white);
      display: flex; align-items: flex-end; padding: var(--gutter) var(--gutter) 18vh;
      opacity: 0; visibility: hidden; transition: opacity var(--fast), visibility var(--fast);
    }
    :global(.menu-open) .header__nav { opacity: 1; visibility: visible; }
    :global(.menu-open) body { overflow: hidden; }
    .header__nav ul { flex-direction: column; gap: var(--s-3); }
    .header__nav a { font-family: var(--grotesk); font-weight: 650; text-transform: uppercase; letter-spacing: var(--track-mark); font-size: var(--t-xl); color: var(--ink); line-height: 1.0; }
  }
</style>
