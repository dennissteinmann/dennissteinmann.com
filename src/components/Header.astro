---
import { NAV, SITE } from '@/site.config';
import Crest from './Crest.astro';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href));
---

<header class="header">
  <div class="wrap header__inner">
    <a href="/" class="header__brand plain" aria-label={`${SITE.name} – Startseite`}>
      <Crest size="2rem" class="header__crest" />
      <span class="mark header__name">{SITE.name}</span>
    </a>

    <nav class="header__nav" aria-label="Hauptnavigation" id="nav">
      <ul role="list">
        {NAV.map((item) => (
          <li><a href={item.href} class="plain" aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <button class="header__toggle label" type="button" aria-expanded="false" aria-controls="nav" data-menu>Menü</button>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu]');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    btn.textContent = open ? 'Menü' : 'Schließen';
    document.documentElement.classList.toggle('menu-open', !open);
  });
</script>

<style>
  .header { position: sticky; top: 0; z-index: 50; background: var(--bg); border-bottom: 1px solid var(--line); }
  .header__inner { display: flex; align-items: center; justify-content: space-between; gap: var(--s-4); padding-block: var(--s-3); }

  .header__brand { display: flex; align-items: center; gap: var(--s-3); color: var(--ink); }
  .header__brand :global(.header__crest) { color: var(--navy); }
  .header__name { font-size: var(--t-caps); letter-spacing: 0.18em; white-space: nowrap; }

  .header__nav ul { display: flex; gap: clamp(1.1rem, 2.4vw, 2.5rem); }
  .header__nav a {
    font-family: var(--sans); font-size: var(--t-xs); font-weight: 500; text-transform: uppercase; letter-spacing: var(--track-caps);
    color: var(--ink-soft); text-decoration: underline; text-decoration-color: transparent; text-decoration-thickness: 1px; text-underline-offset: 0.7em;
  }
  .header__nav a:hover { color: var(--ink); text-decoration-color: var(--line-strong); }
  .header__nav a[aria-current='page'] { color: var(--ink); text-decoration-color: var(--accent); }

  .header__toggle { display: none; color: var(--ink); }

  @media (max-width: 960px) {
    .header__toggle { display: block; }
    .header__nav {
      position: fixed; inset: 0; z-index: -1; background: var(--bg);
      display: flex; align-items: flex-end; padding: var(--gutter) var(--gutter) 16vh;
      opacity: 0; visibility: hidden; transition: opacity var(--fast), visibility var(--fast);
    }
    :global(.menu-open) .header__nav { opacity: 1; visibility: visible; }
    :global(.menu-open) body { overflow: hidden; }
    .header__nav ul { flex-direction: column; gap: var(--s-2); width: 100%; }
    .header__nav li { border-top: 1px solid var(--line); padding-top: var(--s-2); }
    .header__nav a {
      font-family: var(--serif); font-size: var(--t-l); font-weight: 400; text-transform: none; letter-spacing: 0;
      color: var(--ink); line-height: 1.2; text-underline-offset: 0.2em;
    }
  }
  @media (max-width: 400px) {
    .header__name { letter-spacing: 0.12em; font-size: var(--t-s); }
    .header__brand { gap: var(--s-2); }
  }
</style>
