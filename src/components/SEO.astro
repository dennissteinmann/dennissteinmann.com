---
/**
 * Alle <head>-Metadaten an EINER Stelle. Seiten übergeben nur Daten,
 * nie eigene <meta>-Tags. Checkliste: docs/SEO.md
 */
import { SITE } from '@/site.config';
import { abs } from '@/lib/seo';

export interface Props {
  title: string;
  description: string;
  /** Pfad relativ zur Domain; Standard = aktuelle URL */
  canonical?: string;
  /** OG-Bild-Pfad (1200×630). Standard: generisches Site-Bild */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  jsonLd?: object;
  /** Alternative Maschinenfassung (z. B. /artikel/x.md) */
  markdownAlt?: string;
}

const {
  title,
  description,
  canonical,
  image = '/og/default.png',
  imageAlt,
  type = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
  tags = [],
  jsonLd,
  markdownAlt,
} = Astro.props;

const isHome = Astro.url.pathname === '/';
const fullTitle = isHome ? `${SITE.name} – ${SITE.tagline}` : `${title} · ${SITE.name}`;
const canonicalURL = canonical ? abs(canonical) : new URL(Astro.url.pathname, SITE.url).href;
const ogImage = abs(image);
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
<meta name="author" content={SITE.name} />

<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt ?? title} />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
{type === 'article' && <meta property="article:author" content={abs('/ueber/')} />}
{tags.map((t) => <meta property="article:tag" content={t} />)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<link rel="alternate" type="application/rss+xml" title={`${SITE.name} – Artikel`} href="/rss.xml" />
<link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
{markdownAlt && <link rel="alternate" type="text/markdown" title="Markdown-Fassung" href={markdownAlt} />}
<link rel="sitemap" href="/sitemap.xml" />

{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
